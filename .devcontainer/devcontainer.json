{
    "name": "DENG Streaming",
    "dockerComposeFile": "docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/workspaces/DENG_FS26",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "forwardPorts": [
        9092,
        8081,
        8888
    ],
    "portsAttributes": {
        "9092": {
            "label": "Redpanda Kafka API"
        },
        "8081": {
            "label": "Flink Web UI"
        },
        "8888": {
            "label": "Dinky",
            "onAutoForward": "openPreview"
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "postCreateCommand": "cd streaming && uv sync",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    }
}
